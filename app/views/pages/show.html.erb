<%= turbo_frame_tag 'boards-pages' do %>
  <div class="pages" data-controller="pages"
    data-pages-global-outlet="#global"
  >
    <%= render 'pages/show_actions' %>

    <%= turbo_frame_tag 'page' do %>
      <%= render 'pages/page' %>
    <% end %>

    <div class="tab-bar" data-controller="tabs">
      <div class="tab active" data-tabs-target="tab">
        <%= Item.model_name.human(count: 2) %>
      </div>
      <%# <div class="tab" data-tabs-target="tab">%>
        <%#= t '.mobile_view' %>
      <%# </div> %>
      <div class="tab"></div>
    </div>

    <%= turbo_frame_tag 'page-items-list' do %>
        <%= render 'pages/items_list' %>
    <% end %>
  </div>
<% end %>
