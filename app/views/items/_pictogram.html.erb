<%= render 'items/card' do %>
  <div class="item <%= css_class_name(item.category) %>"
    data-item-form-target="pictogramCategory"
  >
    <div class="name" data-item-form-target="pictogramName">
      <%= item.name %>
    </div>

    <div class="image">
      <% if item.image.public? %> <%# Used to render items in spreadsheet/page view %>
        <%= image_tag image_path("#{item.image.id}#{File.extname(item.image.image_file_name)}"),
          alt: item.name
        %>
      <% elsif item.image? %>
        <%= image_tag item.image.image.url, alt: item.name,
          data: { 'item-form-target': "pictogramImage" }
        %>
      <% else %>
        <img src="" data-item-form-target="pictogramImage">
      <% end %>
    </div>
  </div>
<% end %>
