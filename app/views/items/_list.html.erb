<div class="items-list">
  <% items.each do |item| %>
    <%= render 'items/item', item: item %>
  <% end %>
</div>

<% if local_assigns[:paginate] %>
  <%= will_paginate @items, param_name: :offset, class: 'paginate',
      params: {
        name: local_assigns[:name],
        controller: 'items',
        action: :private,
        id: current_user
      }
  %>
<% end %>
