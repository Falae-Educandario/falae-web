<div class="item" data-controller="item"
  data-item-id-value="<%= item.id %>"
  data-item-url-value="<%= user_item_path(item.user, item) %>"
>
  <%= button_tag class: 'card-button', type: 'button',
    data: { action: 'item#show' } do
  %>
    <%= render 'items/pictogram', item: item %>
  <% end %>
</div>
