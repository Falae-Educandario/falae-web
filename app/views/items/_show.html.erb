<%= render 'form', item: @item %>

<div class="button-group center"
  data-controller="items"
  data-item-form-global-outlet="#global"
  data-items-global-outlet="#global"
>
  <%= link_to pdf_user_item_path(@user, @item, format: :pdf),
    class: 'button-box', target: '_blank' do
  %>
    <%= fa_icon 'print' %><%= t '.print' %>
  <% end %>

  <% unless item.new_record? %>
    <%= button_tag :destroy, class: 'button-box destroy', type: :button,
      data: {
        path: user_item_path(@user, item, **(@page ? {
            spreadsheet_id: @spreadsheet.id, page_id: @page.id
          } : {})),
        action: 'items#destroy',
        turbo_confirm: (
          @page ?
            t('pages.items.remove_alert') :
            item.pages.any? ?
              destroy_item_confirmation_message(item) :
              t('.destroy_confirm')
        )
      } do
    %>
      <%= fa_icon 'trash-o' %><%= t('.destroy') %>
    <% end %>
  <% end %>
</div>
