<div class="items" data-controller="items"
  data-items-userid-value="<%= @user.id %>"
  data-items-global-outlet="#global"
>
  <%# TODO: Replace notice with "toast notification" %>
  <% if notice %>
    <p id="notice"><%= notice %></p>
  <% end %>

  <%# TODO: Move to action bar partial %>
  <div class="actions-bar">
    <div> <%# TODO: search area here, bellow input "area" %>
      <div class="search-area" data-items-target="searchArea">
        <%= text_field_tag :name, nil, data: { 'items-target': 'searchInput' } %>
        <%= button_tag class: 'button-box', disabled: true, type: :button,
          data: {
            'filter-url': filter_items_user_path(@user),
            'items-target': 'filterButton',
            action: 'items#filterItems'
          } do
        %>
          <%= fa_icon 'filter' %><%= t '.filter.verb' %>
        <% end %>
      </div>
      <div class="search-result" data-items-target="searchResult">
        <span><%= t '.filter.noun' %>:</span>
        <%= button_tag class: 'button-box',  type: :button,
          data: {
            'reset-search-url': private_items_user_path(@user),
            action: 'items#searchClose'
            } do
        %>
          <%= fa_icon 'remove' %><%= t '.filter.name' %>:
          <span data-items-target="filterName"></span>
        <% end %>
      </div>
    </div>

    <div class="button-group" id="new-item">
      <%= button_tag class: 'button-box', type: :button,
        data: {
          action: 'items#new',
          path: new_user_item_path(@user)
        } do
      %>
        <%= fa_icon 'plus-circle' %><%= t '.new' %>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag 'items-list',
    data: {
      'items-target': "itemsList",
      'autoscroll': true,
      'autoscroll-behavior': "smooth"
    } do
  %>
    <% if @items.present? %>
      <%= render 'items/list', items: @items,
        paginate: local_assigns[:paginate],
        name: local_assigns[:name],
        offset: local_assigns[:offset]
      %>
    <% elsif local_assigns[:name] %>
      <p><%= t '.filter.no-results' %></p>
    <% else %>
      <p><%= t '.none' %></p>
    <% end %>
  <% end %>
</div>
