<div class="item form-box" data-controller="item"
  data-item-global-outlet="#global"
>
  <%# TODO: change method to patch/put use better parameter to use for edit and create %>
  <%= form_with model: [item.user, item], data: { 'item-target': 'form' } do |form| %>
    <div>
      <div class="pictogram">
        <%= render 'items/pictogram', item: item %>
      </div>

      <% unless local_assigns[:search_result] %>
        <div class="wrapper-custom-input-file">
          <%= form.fields_for :image do |image| %>
            <% [:crop_x, :crop_y, :crop_w, :crop_h].each do |attribute| %>
              <%= image.hidden_field attribute, id: attribute,
                data: { 'item-target': attribute.to_s.camelize(:lower) }
              %>
            <% end %>

            <%= image.file_field :image, data: { 'item-target': 'fileInput' } %>

            <%= image.label :image, class: 'custom-input-file' do %>
              <%= fa_icon 'upload' %> <%= t '.upload_file' %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="fields<%= local_assigns[:search_result] ? ' private' : '' %>">
      <p class="field">
        <strong><%= Item.human_attribute_name :name %>:</strong>
        <%= form.text_field :name, id: :item_name, data: {'item-target': 'name'},
          disabled: local_assigns[:search_result]
        %>
      </p>

      <div class="field">
        <strong><%= Item.human_attribute_name :speech %>:</strong>
        <%= form.text_field :speech, id: :item_speech, data: { 'item-target': 'speech' },
          disabled: local_assigns[:search_result]
        %>
      </div>

      <div class="field">
        <strong><%= Category.model_name.human %>:</strong>
        <%= form.select :category_id,
          options_for_select(select_options_for_categories, category_id(item)),
          {},
          { data: { 'item-target': 'categoryId' }, disabled: local_assigns[:search_result] }
        %>
      </div>

      <div class="actions">
        <%= form.button :submit, name: :save, data: { action: 'item#upsert' } do %>
          <%= fa_icon 'floppy-o' %><%= t '.save' %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
