<%= turbo_frame_tag 'boards-pages' do %>
  <div class="spreadsheet" data-controller="boards"
    data-boards-global-outlet="#global"
  >
    <div class="button-group">
      <%= link_to user_spreadsheets_path(@user), class: 'button-box',
        data: { turbo_action: 'advance' } do
      %>
        <%= fa_icon 'arrow-left' %><%= t '.back' %>
      <% end %>

      <%= link_to user_spreadsheet_export_path(@user, @spreadsheet),
        class: 'button-box' do %>
        <%= fa_icon 'upload' %><%= t '.export' %>
      <% end %>

      <%= button_tag class: 'button-box', type: :button,
        data: {
          action: 'boards#edit',
          path: edit_user_spreadsheet_path(@user, @spreadsheet),
          title: t('.edit')
        } do
      %>
        <%= fa_icon 'edit' %><%= t '.edit' %>
      <% end %>

      <%= link_to user_spreadsheet_path(@user, @spreadsheet),
        class: 'button-box destroy',
        data: {
          turbo_confirm: t('.destroy_alert'),
          turbo_method: :delete,
          turbo_action: 'advance'
        } do
      %>
        <%= fa_icon 'trash-o' %><%= t '.destroy' %>
      <% end %>
    </div>

    <%= turbo_frame_tag 'board' do %>
      <%= render partial: 'spreadsheet' %>
    <% end %>

    <%# TODO: Move these buttons to pages show %>
    <%
=begin%>
 <div class="button-group right">
      <%= link_to user_spreadsheet_import_page_path(@user, @spreadsheet), class: 'button-box', remote: true do %>
        <%= fa_icon 'download' %><%= t '.import' %>
      <% end %>

      <%= link_to new_user_spreadsheet_page_path(@user, @spreadsheet), class: 'button-box' do %>
        <%= fa_icon 'plus-circle' %><%= t '.new_page' %>
      <% end %>
    </div>
<%
=end%>

    <%= render 'pages/index' %>
  </div>
<% end %>
